<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="100%" height="100%">
  <defs>
    <!-- Sharp background gradient -->
    <linearGradient id="bgGlow" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0284C7" />
      <stop offset="100%" stop-color="#0F172A" />
    </linearGradient>
  </defs>

  <!-- Rounded App Tile Frame -->
  <rect width="512" height="512" rx="110" fill="url(#bgGlow)"/>

  <!-- Thick Outer Cyan Border -->
  <rect x="16" y="16" width="480" height="480" rx="94" fill="none" stroke="#38BDF8" stroke-width="24"/>

  <!-- Bold, Ultra-Legible "PZX" Text -->
  <text x="256" y="325" 
        font-family="Impact, 'Arial Black', sans-serif" 
        font-weight="900" 
        font-size="210" 
        fill="#FFFFFF" 
        text-anchor="middle" 
        letter-spacing="12">
    PZX
  </text>
</svg>
